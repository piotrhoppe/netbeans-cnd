                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>collect-nbms</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.basedir}/target/nbms"/>
                                        <copy todir="${project.basedir}/target/nbms" flatten="true">
                                            <fileset dir="${project.basedir}">
                                                <include name="**/target/*.nbm"/>
                                                <exclude name="target/nbms/**"/>
                                            </fileset>
                                        </copy>
                                        <echo message="NBM files collected in target/nbms/"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- All NB artifacts are available on Maven Central — no extra repositories needed -->
</project>
