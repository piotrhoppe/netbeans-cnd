<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.netbeans.cnd</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>NetBeans C/C++ Plugin — Parent POM</name>
    <description>C/C++ language support for Apache NetBeans IDE</description>
    <url>https://github.com/apache/netbeans-cnd</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/apache/netbeans-cnd.git</connection>
        <developerConnection>scm:git:https://github.com/apache/netbeans-cnd.git</developerConnection>
        <url>https://github.com/apache/netbeans-cnd</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>

        <!-- NetBeans Platform version (LTS) -->
        <netbeans.version>RELEASE230</netbeans.version>

        <!-- Plugin versions -->
        <nbm.maven.plugin.version>4.9</nbm.maven.plugin.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.0</maven.surefire.plugin.version>
    </properties>

    <modules>
        <module>dlight</module>
        <module>cnd</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- NetBeans Platform BOM -->
            <dependency>
                <groupId>org.netbeans.cluster</groupId>
                <artifactId>platform</artifactId>
                <version>${netbeans.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal dlight modules -->
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>dlight-libs-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>dlight-remote</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>dlight-remote-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>dlight-remote-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>dlight-sendto</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal cnd modules -->
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-utils</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-utils-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-api-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-api-remote</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-api-remote-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-lexer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-source</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-toolchain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-toolchain-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-editor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-makeproject</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-makeproject-source-bridge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-makeproject-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-debugger-common2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-debugger-gdb2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-remote</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-remote-projectui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-remote-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-lsp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-meson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-script</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-dwarfdump</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.netbeans.cnd</groupId>
                <artifactId>cnd-kit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.netbeans.utilities</groupId>
                    <artifactId>nbm-maven-plugin</artifactId>
                    <version>${nbm.maven.plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <sourceManifestFile>src/main/nbm/manifest.mf</sourceManifestFile>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>netbeans</id>
            <name>NetBeans Maven Repository</name>
            <url>https://netbeans.apidesign.org/maven2/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>netbeans</id>
            <name>NetBeans Maven Repository</name>
            <url>https://netbeans.apidesign.org/maven2/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
