    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.netbeans.cnd</groupId>
        <artifactId>cnd-parent</artifactId>
        <version>0.1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cnd-makeproject-ui</artifactId>
    <packaging>nbm</packaging>
    <name>CND — Make Project UI</name>
    <url>https://github.com/piotrhoppe/netbeans-cnd</url>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test/unit/src</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <cluster>cnd</cluster>
                    <moduleName>org.netbeans.modules.cnd.makeproject.ui</moduleName>
                    <sourceManifestFile>manifest.mf</sourceManifestFile>
                    <publicPackages>
                        <publicPackage>org.netbeans.modules.cnd.makeproject.api.ui</publicPackage>
                        <publicPackage>org.netbeans.modules.cnd.makeproject.api.ui.actions</publicPackage>
                        <publicPackage>org.netbeans.modules.cnd.makeproject.api.ui.configurations</publicPackage>
                        <publicPackage>org.netbeans.modules.cnd.makeproject.api.ui.wizard</publicPackage>
                    </publicPackages>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <maven.test.skip>true</maven.test.skip>
    </properties>
